@startuml
' ============================================================================
' C4 Model - Diagrama de Despliegue (infraestructura)
' Objetivo: hacer VISIBLE la alta disponibilidad y la escalabilidad.
' Decision de diseno del diagrama: las zonas de disponibilidad contienen el
' COMPUTO, y la capa de datos se dibuja como un servicio gestionado aparte.
' Motivo: la base de datos multi-AZ es un servicio regional gestionado, no un
' componente que viva dentro de una zona; ademas, dibujar la cadena de
' replicacion dentro de las zonas obligaba a apilarlas y rompia la lectura
' "tres zonas en paralelo" que es justamente el mensaje de disponibilidad.
' Las etiquetas de zona se conservan en cada nodo de datos.
' ============================================================================
!include <C4/C4_Deployment>

title <size:22><b>Diagrama de Despliegue — Alta Disponibilidad y Escalabilidad</b></size>\n<size:14>Topología multi-AZ con región de recuperación ante desastres</size>

Deployment_Node(aws, "AWS", "Proveedor cloud") {

  Deployment_Node(primary, "Región primaria", "us-east-1") {

    Container(edge, "Capa de borde", "Route 53 + ALB + WAF", "Verifica salud y distribuye tráfico entre las tres zonas. Una zona caída sale de rotación sin intervención.")

    Deployment_Node(vpc, "VPC 10.0.0.0/16", "") {

      together {
        Deployment_Node(azA, "Zona de disponibilidad A", "us-east-1a") {
          Container(appA, "Servicios de aplicación", "EKS · m6i.xlarge · 2–8 nodos", "ac01–ac09 sin estado · anti-affinity por zona · autoescala por cola y RPS")
          Container(gpuA, "Inferencia GPU", "EKS · g5.xlarge · 1–3 nodos", "Multi-Label Inference Service · autoescala por profundidad de cola")
          Container(natA, "NAT Gateway", "una puerta por zona", "La salida a internet es independiente por zona")
        }

        Deployment_Node(azB, "Zona de disponibilidad B", "us-east-1b") {
          Container(appB, "Servicios de aplicación", "EKS · m6i.xlarge · 2–8 nodos", "ac01–ac09 sin estado · anti-affinity por zona")
          Container(gpuB, "Inferencia GPU (ráfaga)", "EKS · g5.xlarge · 0–2 nodos", "Nodos spot para absorber las pasadas satelitales")
        }

        Deployment_Node(azC, "Zona de disponibilidad C", "us-east-1c") {
          Container(appC, "Servicios de aplicación", "EKS · m6i.xlarge · 2–8 nodos", "ac01–ac09 sin estado · anti-affinity por zona")
        }
      }

      Deployment_Node(dataTier, "Capa de datos gestionada", "Amazon RDS for PostgreSQL · Multi-AZ") {
        ContainerDb(dbA, "Primario", "db.r6g.2xlarge · us-east-1a", "Acepta escrituras")
        ContainerDb(dbB, "Standby síncrono", "db.r6g.2xlarge · us-east-1b", "Asume por failover automático")
        ContainerDb(dbC, "Réplica de lectura", "db.r6g.xlarge · us-east-1c", "Escala consultas de API y analítica")
      }

      ContainerQueue(kafka, "Bus de eventos", "Amazon MSK · 3 brokers", "Log particionado replicado 3× · un broker por zona · particionado por tile")
    }

    ContainerDb(s3, "Almacenamiento de objetos", "Amazon S3 · servicio regional", "Escenas y artefactos de modelo · versionado · ciclo de vida a capas frías")
  }

  Deployment_Node(dr, "Región de recuperación ante desastres", "us-west-2") {
    Container(drCluster, "Clúster en espera", "EKS · capacidad mínima", "Escalado a cero o mínimo; se expande solo ante una conmutación regional")
    ContainerDb(drS3, "Réplica de objetos", "S3 Cross-Region Replication", "Replicación continua desde la región primaria")
    ContainerDb(drSnap, "Respaldos de base de datos", "Snapshots + point-in-time recovery", "Restauración a un punto en el tiempo")
  }
}

Rel(edge, appA, "Distribuye tráfico", "HTTPS")
Rel(edge, appB, "Distribuye tráfico", "HTTPS")
Rel(edge, appC, "Distribuye tráfico", "HTTPS")
Rel(appA, kafka, "Publica y consume", "Kafka")
Rel(appB, kafka, "Publica y consume", "Kafka")
Rel(gpuA, kafka, "Consume jobs", "Kafka")
Rel(gpuB, kafka, "Consume jobs", "Kafka")
Rel(appA, dbA, "Lee y escribe", "SQL")
Rel(dbA, dbB, "Réplica síncrona · failover automático", "RPO ≈ 0")
Rel(dbA, dbC, "Réplica asíncrona", "lecturas")
Rel(dbB, dbC, "Réplica asíncrona", "lecturas")
Rel(s3, drS3, "Replicación entre regiones", "CRR")
Rel(dbA, drSnap, "Respaldos periódicos", "PITR")
Rel(drCluster, drSnap, "Conmutación regional", "RTO 4 h")

note right of dbB
  <b>El corazón de la disponibilidad</b>
  Réplica síncrona + conmutación automática
  gestionada: RPO ≈ 0 y RTO bajo, sin operación
  manual ni ventana de mantenimiento.
end note

note right of kafka
  <b>Por qué un log y no una cola en memoria</b>
  Perder un broker no pierde eventos: el factor de
  replicación 3 permite reprocesar. Con una cola
  en memoria, un reinicio en una pasada satelital
  significaría perder escenas.
end note

@enduml
