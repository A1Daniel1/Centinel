@startuml
' ============================================================================
' C4 Model - Nivel 3: Diagrama de Componentes
' Alcance: UN SOLO contenedor -> Multi-Label Inference Service (ac04)
' Este es el nucleo de IA/ML del proyecto y justifica el nivel de detalle.
' ============================================================================
!include <C4/C4_Component>

title <size:22><b>Nivel 3 — Diagrama de Componentes</b></size>\n<size:14>Contenedor: Multi-Label Inference Service · el núcleo de IA/ML del sistema</size>

Container_Boundary(inference, "Multi-Label Inference Service", "PyTorch / gRPC") {

  Component(inf01, "Inference gRPC Server", "Python / gRPC", "Expone el contrato de inferencia y gobierna el ciclo de vida de cada petición.")
  Component(inf02, "Request Validator", "Python", "Verifica precondiciones: bandas completas, corregistro y metadatos mínimos.")
  Component(inf03, "Feature Assembler", "Python", "Recupera y alinea los vectores de características fusionados.")
  Component(inf04, "Model Registry Client", "Python", "Resuelve la versión de modelo solicitada y comprueba su integridad.")
  Component(inf05, "Model Artifact Cache", "Filesystem / PVC", "Caché local de artefactos para no descargar el modelo en cada arranque o réplica.")
  Component(inf06, "Batch Scheduler", "Python", "Agrupa peticiones en micro-lotes para maximizar el uso de la GPU.")
  Component(inf07, "Multi-Label Classifier", "PyTorch", "Modelo conjunto que emite probabilidades por fenómeno en una sola pasada.")
  Component(inf08, "Confidence Calibrator", "Python", "Calibración de probabilidades por fenómeno (temperature scaling).")
  Component(inf09, "Threshold Policy", "Python", "Umbrales por etiqueta y política de compromiso precisión-exhaustividad expuesta al operador.")
  Component(inf10, "Prediction Publisher", "Python / Kafka", "Publica el resultado multi-etiqueta hacia el filtro de falsas alarmas.")
  Component(inf11, "Telemetry Exporter", "OpenTelemetry", "Métricas, logs y trazas del contenedor hacia la plataforma de observabilidad.")
}

Container_Ext(broker, "Message Broker", "Kafka", "Cola asíncrona particionada por tile.")
Container_Ext(store, "Object Storage", "S3-compatible", "Escenas raster y artefactos de modelo versionados.")
Container_Ext(vector, "Vector Similarity Service", "Python", "Búsqueda por similitud sobre patrones históricos.")
Container_Ext(filter, "False-Alarm Filter Service", "Python", "Supresión de falsos positivos.")
Container_Ext(obs, "Observability Platform", "Prometheus / Grafana", "Métricas, logs y trazas.")

Rel(broker, inf01, "Entrega jobs de inferencia", "Kafka")
Rel(inf01, inf02, "Somete la petición a validación", "in-process")
Rel(inf02, inf03, "Solicita el vector de características", "in-process")
Rel(inf03, store, "Lee vectores fusionados persistidos", "S3 API")
Rel(inf03, inf06, "Encola el vector listo para inferir", "in-process")
Rel(inf04, store, "Descarga el artefacto de modelo", "S3 API")
Rel(inf04, inf05, "Publica el artefacto en caché", "filesystem")
Rel(inf05, inf07, "Entrega el modelo cargado", "in-process")
Rel(inf06, inf07, "Despacha micro-lotes", "in-process")
Rel(inf07, inf08, "Emite probabilidades crudas", "in-process")
Rel(inf08, inf09, "Aplica la política de umbrales", "in-process")
Rel(inf09, inf10, "Confirma el conjunto de etiquetas", "in-process")
Rel(inf07, vector, "Solicita patrones históricos análogos", "gRPC")
Rel(inf10, filter, "Publica predicciones", "Kafka")
Rel(inf11, obs, "Exporta telemetría", "OTLP")

note right of inf07
  <b>Por qué este contenedor y no otro</b>
  Un nivel 3 describe <b>un solo contenedor</b>, no el sistema completo.
  Se elige el servicio de inferencia porque concentra la hipótesis
  central del proyecto: si un clasificador multi-etiqueta conjunto
  supera a tres detectores binarios independientes.
end note

note right of inf09
  <b>El punto donde el operador decide</b>
  Threshold Policy mueve el compromiso precisión-exhaustividad
  sin reentrenar el modelo, y deja auditado el umbral vigente
  junto a cada alerta emitida.
end note

@enduml
